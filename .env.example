GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# On Vercel this may be left unset (falls back to VERCEL_URL), but set it
# explicitly to your stable, OAuth-registered domain for production.
PUBLIC_BASE_URL=https://your-agent-genaie-domain.example
GOOGLE_REDIRECT_URI=https://your-agent-genaie-domain.example/auth/google/callback

# Secrets: set ALL of these to distinct random values (e.g. `openssl rand -base64 32`).
# If unset, the ones below fall back to TOKEN_ENCRYPTION_SECRET, which means one
# leaked secret would compromise token encryption, credential encryption, OAuth
# state signing, and setup-link tokens all at once.
#
# WARNING: TOKEN_ENCRYPTION_SECRET and CENTRAL_DATA_ENCRYPTION_SECRET encrypt
# data at rest (data/tokens.json and Firestore credentialRefs). Changing them
# after launch makes existing stored credentials undecryptable. If production
# previously ran with only TOKEN_ENCRYPTION_SECRET set, pin
# CENTRAL_DATA_ENCRYPTION_SECRET to that same value; only rotate it together
# with a re-encryption migration.
# Changing OAUTH_STATE_SECRET only invalidates in-flight OAuth flows (10 min).
# Changing JOB_SCOUT_SETUP_SECRET / ACCOUNT_LINK_SETUP_SECRET invalidates
# pending setup invites (24 h TTL); the agent can simply issue new links.
TOKEN_ENCRYPTION_SECRET=
OAUTH_STATE_SECRET=
JOB_SCOUT_SETUP_SECRET=
ACCOUNT_LINK_SETUP_SECRET=
CENTRAL_DATA_ENCRYPTION_SECRET=
CENTRAL_DATA_KEY_VERSION=v1

FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=
FIREBASE_EMAIL_LINK_URL=https://your-agent-genaie-domain.example/auth/firebase/finish
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=
OWNER_FIREBASE_UID=
AGENT_GENAI_INTERNAL_API_KEY=
HOST=127.0.0.1
PORT=3010
